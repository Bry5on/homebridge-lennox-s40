{
  "pluginAlias": "LennoxS40Platform",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Lennox S40 over local LCC. Enable a child bridge in plugin Bridge Settings to isolate the long-poll loop from other plugins. Changing host/zones does not require resetOnBoot if UUIDs stay `lennox-s40-zone:<id>`.",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "title": "Name", "default": "Lennox S40" },
      "host": { "type": "string", "title": "Thermostat URL", "required": true, "description": "e.g. https://192.168.1.50" },
      "clientId": { "type": "string", "title": "LCC SenderId", "default": "homebridge" },
      "zoneIds": {
        "type": "array",
        "title": "Zone IDs",
        "items": { "type": "integer" },
        "default": [0]
      },
      "verifyTLS": { "type": "boolean", "title": "Verify TLS certificate", "default": false },
      "longPollSeconds": { "type": "integer", "title": "Long-poll timeout (s)", "default": 15, "minimum": 5, "maximum": 60 },
      "resetOnBoot": { "type": "boolean", "title": "Unregister and recreate accessories on every start", "default": false },
      "logBodies": { "type": "boolean", "title": "Debug: log HTTP bodies", "default": false }
    }
  }
}
