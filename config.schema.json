{
  "pluginAlias": "LennoxS40Platform",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "default": "Lennox S40"
      },
      "host": {
        "type": "string",
        "title": "Thermostat address",
        "description": "https://IP or hostname of the S40",
        "required": true
      },
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "default": "homebridge"
      },
      "zoneIds": {
        "type": "array",
        "title": "Zone IDs",
        "items": { "type": "integer" },
        "default": [0]
      },
      "verifyTLS": {
        "type": "boolean",
        "title": "Verify TLS",
        "default": false
      },
      "longPollSeconds": {
        "type": "integer",
        "title": "Long-poll timeout (s)",
        "default": 15,
        "minimum": 5,
        "maximum": 60
      },
      "resetOnBoot": {
        "type": "boolean",
        "title": "Reset cached accessories on boot",
        "default": true
      },
      "logBodies": {
        "type": "boolean",
        "title": "Log HTTP bodies",
        "default": false
      }
    }
  }
}
